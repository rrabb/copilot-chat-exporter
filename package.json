{
  "name": "copilot-chat-exporter",
  "version": "0.1.0",
  "private": true,
  "description": "Export a VS Code Copilot chat session to a rich, human-readable Markdown archive: prompts, agent reasoning, tool calls, code blocks, token cost, and timing.",
  "license": "MIT",
  "author": { "name": "Reiman Rabbani", "email": "rrabbani@esri.com", "url": "https://github.com/rrabb" },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "copilot-chat-export": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "ci",
    "docs",
    "skill",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "export": "node src/cli.ts",
    "list": "node src/cli.ts --list",
    "golden": "node scripts/test.mjs --command src/cli.ts --golden check",
    "golden:update": "node scripts/test.mjs --command src/cli.ts --golden update",
    "snapshot": "node src/cli.ts --snapshot",
    "baseline": "node scripts/test.mjs --command test/baseline.ts",
    "baseline:update": "node scripts/test.mjs --command test/baseline.ts --update",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "verify": "npm run verify:generated && npm run typecheck && npm run typecheck:test && npm run test && npm run golden",
    "verify:generated": "node scripts/generate-brotli.mjs --check",
    "verify:local": "npm run verify && npm run baseline",
    "build": "node scripts/build.mjs",
    "generate:brotli": "node scripts/generate-brotli.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "vscode",
    "copilot",
    "chat",
    "export",
    "markdown",
    "transcript"
  ],
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "^25.9.1",
    "brotli-dec-wasm": "2.3.2",
    "esbuild": "^0.27.7",
    "markdown-it": "14.3.3",
    "typescript": "^5.9.3"
  }
}
